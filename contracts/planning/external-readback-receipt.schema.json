{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GonzaloTorreras/ai-dememory/contracts/planning/external-readback-receipt.schema.json",
  "title": "ai DeMemory external readback receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "receipt_type",
    "receipt_version",
    "task_id",
    "contract_id",
    "kind",
    "source",
    "consumer",
    "schema_identity",
    "environment",
    "fixture_identity",
    "readback",
    "secret_scan",
    "details"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 64,
      "enum": ["../../external-readback-receipt.schema.json"]
    },
    "receipt_type": {
      "type": "string",
      "maxLength": 32,
      "enum": ["external-readback"]
    },
    "receipt_version": {"type": "integer", "enum": [1]},
    "task_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Z]+-[0-9A-Z]+$"
    },
    "contract_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "kind": {"type": "string", "minLength": 1, "maxLength": 64},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "artifact_sha256"],
      "properties": {
        "commit": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "artifact_sha256": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "artifact_sha256",
        "server_profile",
        "allowlist_sha256"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "artifact_sha256": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "server_profile": {"type": "string", "minLength": 1, "maxLength": 64},
        "allowlist_sha256": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "schema_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifact_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "artifact_sha256": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "python", "protocol"],
      "properties": {
        "os": {"type": "string", "minLength": 1, "maxLength": 128},
        "python": {"type": "string", "minLength": 1, "maxLength": 64},
        "protocol": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "fixture_identity": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^(not-applicable|sha256:[0-9a-f]{64})$"
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions", "sanitized", "passed"],
      "properties": {
        "sessions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "lifecycle",
              "redaction_manifest",
              "result",
              "passed"
            ],
            "properties": {
              "session_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "lifecycle": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "artifact_sha256", "byte_size"],
                "properties": {
                  "path": {"type": "string", "minLength": 1, "maxLength": 512},
                  "artifact_sha256": {"type": "string", "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
                  "byte_size": {"type": "integer", "minimum": 1, "maximum": 65536}
                }
              },
              "redaction_manifest": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "artifact_sha256", "byte_size"],
                "properties": {
                  "path": {"type": "string", "minLength": 1, "maxLength": 512},
                  "artifact_sha256": {"type": "string", "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
                  "byte_size": {"type": "integer", "minimum": 1, "maximum": 65536}
                }
              },
              "result": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "artifact_sha256", "byte_size"],
                "properties": {
                  "path": {"type": "string", "minLength": 1, "maxLength": 512},
                  "artifact_sha256": {"type": "string", "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
                  "byte_size": {"type": "integer", "minimum": 1, "maximum": 65536}
                }
              },
              "passed": {"type": "boolean", "enum": [true]}
            }
          }
        },
        "sanitized": {"type": "boolean", "enum": [true]},
        "passed": {"type": "boolean", "enum": [true]}
      }
    },
    "secret_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanner", "result", "passed"],
      "properties": {
        "scanner": {"type": "string", "minLength": 1, "maxLength": 128},
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "artifact_sha256", "byte_size"],
          "properties": {
            "path": {"type": "string", "minLength": 1, "maxLength": 512},
            "artifact_sha256": {"type": "string", "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
            "byte_size": {"type": "integer", "minimum": 1, "maximum": 65536}
          }
        },
        "passed": {"type": "boolean", "enum": [true]}
      }
    },
    "details": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "artifact_sha256", "byte_size"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "artifact_sha256": {"type": "string", "maxLength": 64, "pattern": "^[0-9a-f]{64}$"},
          "byte_size": {"type": "integer", "minimum": 1, "maximum": 65536}
        }
      }
    }
  }
}
