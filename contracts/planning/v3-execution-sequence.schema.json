{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GonzaloTorreras/ai-dememory/contracts/planning/v3-execution-sequence.schema.json",
  "title": "ai DeMemory V3 execution sequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "planning_status",
    "updated_at",
    "current_frontier",
    "batches",
    "tasks"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 512},
    "contract_version": {"type": "integer", "minimum": 1, "maximum": 1000},
    "planning_status": {"type": "string", "minLength": 1, "maxLength": 64},
    "updated_at": {"type": "string", "format": "date"},
    "current_frontier": {
      "type": "array",
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 64},
      "uniqueItems": true
    },
    "batches": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "depends_on", "tasks"],
        "properties": {
          "id": {"type": "string", "maxLength": 32, "pattern": "^B[0-9A-Za-z]+$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 256},
          "depends_on": {
            "type": "array",
            "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 32},
            "uniqueItems": true
          },
          "tasks": {
            "type": "array",
            "maxItems": 512,
            "items": {"type": "string", "minLength": 1, "maxLength": 64},
            "uniqueItems": true
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "batch",
          "title",
          "status",
          "depends_on",
          "evidence",
          "external_readback_required"
        ],
        "properties": {
          "id": {"type": "string", "maxLength": 64, "pattern": "^[A-Z]+-[0-9A-Z]+$"},
          "batch": {"type": "string", "maxLength": 32, "pattern": "^B[0-9A-Za-z]+$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 256},
          "status": {"enum": ["pending", "in_progress", "blocked", "complete", "future"]},
          "depends_on": {
            "type": "array",
            "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 64},
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "maxItems": 64,
            "items": {"type": "string", "minLength": 1, "maxLength": 512},
            "uniqueItems": true
          },
          "external_readback_required": {"type": "boolean"},
          "external_readback_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract_id",
              "kind",
              "minimum_sessions",
              "fixture_required",
              "required_detail_names"
            ],
            "properties": {
              "contract_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "kind": {"type": "string", "minLength": 1, "maxLength": 64},
              "minimum_sessions": {"type": "integer", "minimum": 1, "maximum": 16},
              "fixture_required": {"type": "boolean"},
              "required_detail_names": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
