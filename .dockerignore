# Deny the entire checkout, then admit only package build inputs. This keeps
# ignored private vault/runtime directories out of the Docker build context.
**
!pyproject.toml
!README.md
!LICENSE
!ai_dememory_tool/
!ai_dememory_tool/**
!scripts/
!scripts/**
!mcp/
!mcp/**

# These remain denied even if accidentally created below an admitted source
# directory.
**/__pycache__/
**/*.pyc
**/*.pyo
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*service-account*.json
