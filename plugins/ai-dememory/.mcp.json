{
  "mcpServers": {
    "ai-dememory": {
      "command": "ai-dememory",
      "args": [
        "mcp",
        "--stdio",
        "--idle-timeout-seconds",
        "600",
        "--require-version",
        "2.1.0",
        "--profile",
        "public",
        "--require-bound-root"
      ],
      "env": {},
      "enabled": true,
      "default_tools_approval_mode": "prompt",
      "enabled_tools": [
        "memory.search",
        "memory.get",
        "memory.context"
      ]
    }
  }
}
